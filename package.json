{
  "name": "toolverse",
  "version": "1.5.0",
  "description": "Toolverse — 274 React components + 1,009 icons × 7 variants (line, solid, duotone, aurora, neon, glass, crystal3d). Real theme system, zero-dependency CLI (add · icons · theme), tree-shakeable, TypeScript strict, MIT.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "cli",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "toolverse": "cli/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "prepublishOnly": "npm run build",
    "cli:add": "node cli/index.js add",
    "playground": "cd playground && npm install && npm run dev",
    "playground:install": "cd playground && npm install",
    "playground:dev": "cd playground && npm run dev",
    "playground:build": "cd playground && npm run build"
  },
  "keywords": [
    "react",
    "react-components",
    "cli",
    "vue",
    "svelte",
    "angular",
    "components",
    "ui",
    "ui-kit",
    "ui-library",
    "design-system",
    "component-library",
    "tailwind",
    "shadcn",
    "shadcn-ui",
    "radix",
    "headless",
    "icons",
    "svg-icons",
    "toolverse",
    "typescript",
    "accessible",
    "themeable",
    "dark-mode",
    "frontend",
    "web-components"
  ],
  "author": "Toolverse <hello@toolverse.ai>",
  "license": "MIT",
  "homepage": "https://toolverse-official.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/imranah10/toolverse"
  },
  "bugs": {
    "url": "https://github.com/imranah10/toolverse/issues"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "react-dom": { "optional": true },
    "vue": { "optional": true },
    "svelte": { "optional": true }
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0"
  },
  "engines": {
    "node": ">=16"
  },
  "sideEffects": [
    "*.css"
  ]
}
